APP_NAME=Tracking Portal API
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./tracking_portal.db
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
RUNTIME_DIR=./runtime_data
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-local
ALLOW_DEMO_PORTAL_FALLBACK=true
ALLOW_DEMO_ACCOUNT_BOOTSTRAP=true
ENABLE_DEMO_SHIPMENT_ADOPTION=true
SEED_TEST_USERS=
